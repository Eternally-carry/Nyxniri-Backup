gestures {
    hot-corners {
        off
    }
}

input {
    keyboard {
        xkb 

        numlock
    }
    touchpad {
        tap
        natural-scroll
	accel-speed 0.4
	accel-profile "flat"
	scroll-factor 1.35
    }
    mouse {
        accel-speed -0.72
    }
    trackpoint{
    	accel-speed 0.5
	accel-profile "flat"
    }
}
