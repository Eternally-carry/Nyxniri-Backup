{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.local/share/fastfetch/images/penrose-sky-wp.png",
    	"type": "kitty",
      	"height": 18,
      	"padding": {
    		"top": 1,
            "right": 2
      	}
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "keys": "magenta",
            "title": "magenta"
        },
        "key": {
            "width": 6
        }
    },
    "modules": [
	"break",
        {
            "type": "custom",
            "format": " {#magenta}みず かがみ{#} ———— hanser小天使！！"
        },
        "break",
        {
            "type": "os",
            "key": "OS",
            "keyColor": "light_magenta"
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": " ├ 󰏖 ",
            "keyColor": "magenta",
            "text": "pacman -Q | wc -l | awk '{print $1\" (pacman)\"}'"
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "magenta" 
        },
        "break",
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "light_magenta" 
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "magenta",
            "format": "{}" 
        },
        {
            "type": "command",
            "key": " ├ 󰀻 ",
            "keyColor": "magenta",
            "text": "gsettings get org.gnome.desktop.interface icon-theme | tr -d \"'\" || echo \"Unknown\""
        },
        {
            "type": "command",
            "key": " ├  ",
            "keyColor": "magenta",
            "text": "echo $XCURSOR_THEME || echo \"Unknown\""
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "magenta"
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "magenta",
            "format": "{}"
        },
        "break",
        {
            "type": "host",
            "format": "{5} {1}",
            "key": "PC",
            "keyColor": "light_magenta"
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}",
            "key": " ├  ",
            "keyColor": "magenta"
        },
	{
            "type": "command",
            "key": " ├ 󰢮 ",
            "keyColor": "magenta",
            "text": "fastfetch -s gpu --pipe | head -n 1 | sed -e 's/GPU ➜ //g' -e 's# /.*##'"
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "magenta"
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "magenta"
        },
        {
            "type": "monitor",
            "format": "{1} {2}x{3} @ {11}Hz",
            "key": " └  ",
            "keyColor": "magenta"
        },
	"break",
        "colors",
        "break"
    ]
}
